---
import Layout from '../../layouts/Layout.astro';
import DashboardShell from '../../components/DashboardShell.astro';
import { servers } from '../../data/servers.js';

const selectedSlug = Astro.url.searchParams.get('server') || servers[0]?.slug;
const selected = servers.find(s => s.slug === selectedSlug) || servers[0];

const navItems = servers.map(server => ({
  href: `/servers?server=${server.slug}`,
  label: server.name,
  active: server.slug === selected?.slug,
  icon: `/icons/${server.icon}`,
  badge: server.partner ? 'Partner' : undefined,
}));
---
<Layout title="Servers">
  <DashboardShell heading="Servers" navItems={navItems}>
  <header class="page-hero">
    <div class="moon" aria-hidden="true"></div>
    <div class="page-hero-eyebrow">Explore</div>
    <h1>Our Servers</h1>
    <p class="page-hero-sub">{servers.length} communities, one network.</p>
  </header>

  <section class="section servers-layout">
    {selected && (
      <div class="server-detail">
        {selected.partner && <span class="badge">Partner Server</span>}
        <div class="detail-head">
          <img src={`/icons/${selected.icon}`} alt={`${selected.name} icon`} class="detail-icon" />
          <div>
            <h3>{selected.name}</h3>
            {selected.contentNotice && <p class="content-notice">{selected.contentNotice}</p>}
          </div>
        </div>
        <p class="detail-description">{selected.description || 'Description coming soon.'}</p>
        <a href={`/servers/${selected.slug}`} class="view-full">View Full Profile &rarr;</a>
      </div>
    )}
  </section>
  </DashboardShell>
</Layout>
<style>
  .servers-layout { padding-top: 0.5rem; }
  .server-detail {
    max-width: 700px;
    margin: 0 auto 2rem;
    padding: 2rem;
    text-align: left;
    background: var(--night-card);
    border: 1px solid var(--card-border);
    border-radius: 4px;
  }
  .badge {
    display: inline-block;
    background: var(--accent-violet);
    color: var(--night-deepest);
    font-family: var(--font-utility);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 1rem;
  }
  .detail-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 1rem;
  }
  .detail-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--card-border);
    flex-shrink: 0;
  }
  .server-detail h3 { color: var(--star-silver); font-size: 1.5rem; }
  .content-notice {
    margin: 6px 0 0;
    font-family: var(--font-utility);
    font-size: 0.78rem;
    color: var(--accent-gold);
  }
  .detail-description {
    font-family: var(--font-body);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 1.5rem;
  }
  .view-full {
    display: inline-block;
    font-family: var(--font-utility);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-violet);
    text-decoration: none;
  }
  .view-full:hover { color: var(--star-silver); }
</style>

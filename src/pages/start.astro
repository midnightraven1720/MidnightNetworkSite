---
import Layout from '../layouts/Layout.astro';
import data from '../data/generated/bots.json';
import { FAQ, TOPIC_COLORS } from '../data/site.js';
import { md, what } from '../lib/md.js';
---
<Layout title="Start here" description="The commands members actually use, by what you want to do.">
  <section class="hero small">
    <div class="eyebrow">Start here</div>
    <h1 class="title">What do you <em>want to do?</em></h1>
    <p class="tagline">Pick a topic. Each one lists the few things worth knowing - the same menu as <code>/help</code> in Discord.</p>
  </section>

  <section class="box">
    <p class="t2">How commands work</p>
    <div class="steps">
      <div class="step"><b>Type <code>/</code></b><p>In any chat box in the server. Discord shows a list of commands.</p></div>
      <div class="step"><b>Pick one</b><p>Keep typing to narrow it down, e.g. <code>/rank</code>, then press Enter or tap it.</p></div>
      <div class="step"><b>Fill the boxes</b><p>Some ask for an option, like a member or a type. Only you see most replies.</p></div>
    </div>
  </section>

  <section class="box gold" data-tabs="hash">
    <div class="tabs" role="tablist">
      {data.topics.map((t) => <button type="button" role="tab" data-tab={t.key}>{t.emoji} {t.label}</button>)}
    </div>
    {data.topics.map((t, i) => (
      <div data-panel={t.key} role="tabpanel">
        <h2 style="text-align:center">{t.emoji} {t.label}</h2>
        <p class="sub">{t.intro}</p>
        <div class="rows">
          {t.items.map((item) => (
            <div class="card" style={`--a:${TOPIC_COLORS[i % TOPIC_COLORS.length]}`}>
              <span set:html={what(item.what)} />
              <p set:html={md(item.how)} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="box">
    <p class="t2">Questions people ask</p>
    <div style="max-width:760px;margin:0 auto">
      {FAQ.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <div set:html={f.a} />
        </details>
      ))}
    </div>
  </section>
</Layout>

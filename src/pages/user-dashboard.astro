---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import DashboardCard from '../components/DashboardCard.astro';
import { requireAuth } from '../lib/session.js';

const { user, redirect } = requireAuth(Astro);
if (redirect) return redirect;

const avatarUrl = user.avatar
  ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128`
  : null;
---

<Layout title="User Dashboard">
  <div class="dashboard-wrapper">
    <Sidebar />
    <main class="content">
      <div class="header-bar">
        <div class="profile-info">
          {avatarUrl && <img src={avatarUrl} alt={user.username} class="profile-avatar" />}
          <h1>Welcome, {user.username}</h1>
        </div>
        <button class="safeword-btn" onclick="alert('Safeword Triggered!')">SAFEWORD</button>
      </div>

      <div class="card-grid">
        <DashboardCard title="Active Tickets">
          <p class="placeholder-note">Coming soon — your open tickets will appear here once Midnight-Gate is live.</p>
        </DashboardCard>
        <DashboardCard title="Current Bonds">
          <p class="placeholder-note">Coming soon — your registered bonds will appear here once Midnight-Community is live.</p>
        </DashboardCard>
        <DashboardCard title="RP Status">
          <p class="placeholder-note">Coming soon — your active scene status will appear here once Midnight Roleplay is live.</p>
        </DashboardCard>
        <DashboardCard title="Level & Currency">
          <p class="placeholder-note">Coming soon — this will show your Server and Network XP, level, and currency wallets once Midnight-Ascend is live.</p>
        </DashboardCard>
        <DashboardCard title="Warnings">
          <p class="placeholder-note">Coming soon — you'll be able to see your own warning count here once Midnight-Council is live.</p>
        </DashboardCard>
        <DashboardCard title="My Profiles">
          <p class="placeholder-note">Coming soon — quick links to your Kink, Gamer, Anime &amp; Manga, and Books profiles once Midnight-Community is live.</p>
        </DashboardCard>
        <DashboardCard title="Server Memberships">
          <p class="placeholder-note">Coming soon — a list of which Midnight Network servers you're a member of.</p>
        </DashboardCard>
      </div>

      {user.rank !== 'member' && (
        <a href="/staff-dashboard" class="staff-link">Staff? View the Staff Dashboard &rarr;</a>
      )}
    </main>
  </div>
</Layout>

<style>
  .dashboard-wrapper { display: flex; position: relative; z-index: 1; }
  .content { padding: 2rem; flex: 1; min-width: 0; }
  .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .profile-info { display: flex; align-items: center; gap: 1rem; }
  .profile-info h1 { font-family: var(--font-display); color: var(--star-silver); }
  .profile-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--card-border);
  }
  .safeword-btn {
    background: #b91c3c;
    color: var(--text-primary);
    border: none;
    padding: 0.5rem 1.2rem;
    font-family: var(--font-utility);
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 100px;
    text-transform: uppercase;
    font-size: 0.78rem;
    transition: background-color 0.2s ease;
  }
  .safeword-btn:hover { background: #d92348; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
  .placeholder-note { font-family: var(--font-body); font-size: 0.88rem; color: var(--text-faint); line-height: 1.5; margin: 0; }
  .staff-link {
    display: block;
    margin-top: 1.5rem;
    font-family: var(--font-utility);
    font-size: 0.9rem;
    color: var(--accent-violet);
    font-weight: 600;
    text-decoration: none;
  }
  .staff-link:hover {
    color: var(--star-silver);
  }
</style>

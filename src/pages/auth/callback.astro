---
import { env, siteUrl, GUILD_ID } from '../../lib/env.js';
import { setSession, isStaff } from '../../lib/session.js';

const code = Astro.url.searchParams.get('code');
const state = Astro.url.searchParams.get('state');
const expected = Astro.cookies.get('oauth_state')?.value;
const next = Astro.cookies.get('oauth_next')?.value || '/me';
Astro.cookies.delete('oauth_state', { path: '/' });
Astro.cookies.delete('oauth_next', { path: '/' });

// Pressed Cancel on Discord's screen, or an old/forged link.
if (!code || !state || state !== expected) return Astro.redirect('/?login=cancelled');

const tokenRes = await fetch('https://discord.com/api/oauth2/token', {
  method: 'POST',
  headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
  body: new URLSearchParams({
    client_id: env('DISCORD_CLIENT_ID') || '',
    client_secret: env('DISCORD_CLIENT_SECRET') || '',
    grant_type: 'authorization_code',
    code,
    redirect_uri: `${siteUrl(Astro)}/auth/callback`,
  }),
});
if (!tokenRes.ok) {
  console.error('Discord login failed:', tokenRes.status, await tokenRes.text());
  return Astro.redirect('/?login=failed');
}
const { access_token } = await tokenRes.json();
const auth = { headers: { Authorization: `Bearer ${access_token}` } };

const userRes = await fetch('https://discord.com/api/users/@me', auth);
if (!userRes.ok) return Astro.redirect('/?login=failed');
const me = await userRes.json();

// Your member record in our server: 404 if you haven't joined.
const memberRes = await fetch(`https://discord.com/api/users/@me/guilds/${GUILD_ID}/member`, auth);
const member = memberRes.ok ? await memberRes.json() : null;

const user = {
  id: me.id,
  username: me.username,
  name: member?.nick || me.global_name || me.username,
  avatar: me.avatar,
  inServer: !!member,
  roles: member?.roles || [],
  joinedAt: member?.joined_at || null,
};
user.staff = await isStaff(user);
setSession(Astro, user);
return Astro.redirect(next);
---

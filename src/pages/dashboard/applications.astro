---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { requireAuth } from '../../lib/session.js';

const { redirect } = requireAuth(Astro);
if (redirect) return redirect;
---

<Layout title="Staff Applications">
  <div class="dashboard-wrapper">
    <Sidebar />
    <main class="content">
      <h1>Staff Applications</h1>
      <p class="placeholder-note">Coming soon — track the status of any staff application you've submitted here.</p>
    </main>
  </div>
</Layout>

<style>
  .dashboard-wrapper { display: flex; position: relative; z-index: 1; }
  .content { padding: 2rem; flex: 1; min-width: 0; }
  .content h1 { font-family: var(--font-display); color: var(--star-silver); margin-bottom: 0.5rem; }
  .placeholder-note { margin: 0.5rem 0 0; font-family: var(--font-body); font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; max-width: 500px; }
</style>

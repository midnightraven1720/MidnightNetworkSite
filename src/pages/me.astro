---
import Layout from '../layouts/Layout.astro';
import { getUser, avatarUrl } from '../lib/session.js';
import { INVITE_URL } from '../lib/env.js';
import { hasDatabase } from '../lib/db.js';
import { getLevel, getProfiles, getCard, getEvents, getReminders, getTimezone, getShelf, STATUS_LABEL, TOPIC_STATES } from '../lib/member-data.js';

const user = getUser(Astro);
const saved = Astro.url.searchParams.get('saved');
const failed = Astro.url.searchParams.get('error');

let me = null;
if (user?.inServer && hasDatabase()) {
  const [level, profiles, card, events, reminders, tz, shelf] = await Promise.all([
    getLevel(user.id), getProfiles(user.id), getCard(user.id), getEvents(user.id), getReminders(user.id), getTimezone(user.id), getShelf(user.id),
  ]);
  me = { level, profiles, card, events, reminders, tz, shelf };
}

const zones = Intl.supportedValuesOf('timeZone');
const fmt = (d: Date, tz: string | null) =>
  new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: tz || 'UTC', timeZoneName: 'short' }).format(new Date(d));
const SHELF = { tbr: '📌 To be read', reading: '📖 Reading', read: '✅ Read', dnf: '⏸️ Did not finish' };
const RSVP = { going: '✅ Going', maybe: '🤔 Maybe', no: '❌ Not going' };
const checklist = me
  ? [
      { done: me.profiles.length > 0, label: 'Make an introduction profile', tab: 'profiles', how: 'In Discord: /profile make type:Introduction' },
      { done: me.card.hasCard, label: 'Set up your DM card', tab: 'card', how: 'Right here, in the DM card tab' },
      { done: !!me.tz, label: 'Add your time zone', tab: 'settings', how: 'Right here, in Settings' },
      { done: me.level.level >= 1, label: 'Chat a little to reach level 1', tab: 'overview', how: 'Every few messages earns XP' },
    ]
  : [];
const doneCount = checklist.filter((c) => c.done).length;
---
<Layout title="My space">
  {!user && (
    <section class="hero small">
      <div class="eyebrow">My space</div>
      <h1 class="title">Your corner of <em>the server</em></h1>
      <p class="tagline">Log in with Discord to see your level, your profiles and events, and to set up your DM card without typing commands.</p>
      <div class="actions"><a class="btn solid" href="/login?next=/me">Log in with Discord</a></div>
      <p class="muted small" style="margin-top:14px">We only see your Discord name, picture and roles in our server. Never your messages or DMs.</p>
    </section>
  )}

  {user && !user.inServer && (
    <section class="hero small">
      <div class="eyebrow">Almost there</div>
      <h1 class="title">You're not in <em>the server</em> yet</h1>
      <p class="tagline">Join Black Rose In Silver first, then come back and log in again.</p>
      <div class="actions">
        {INVITE_URL && <a class="btn solid" href={INVITE_URL}>Join the server</a>}
        <a class="btn" href="/login?next=/me">I've joined - log in again</a>
      </div>
    </section>
  )}

  {user?.inServer && !me && <p class="note warn">Your details can't be loaded right now. Please try again in a few minutes.</p>}

  {me && (
    <>
      <section class="hero small mehero">
        <img src={avatarUrl(user, 256)} alt="" width="96" height="96" />
        <h1 class="title" style="font-size:clamp(30px,6vw,52px)">{user.name}</h1>
        <div class="counts">
          <div><strong>{me.level.level}</strong><span>Level</span></div>
          <div><strong>{me.level.coins.toLocaleString()}</strong><span>Coins</span></div>
          <div><strong>{me.profiles.length}</strong><span>Profiles</span></div>
        </div>
        <div class="lvl">
          <div class="bar" role="progressbar" aria-valuenow={me.level.pct} aria-valuemin="0" aria-valuemax="100"><i style={`width:${me.level.pct}%`}></i></div>
          <p class="muted small">{me.level.into} / {me.level.need} XP to level {me.level.level + 1}{me.level.nextArea ? ` · ${me.level.nextArea.emoji || ''} ${me.level.nextArea.name} opens at level ${me.level.nextArea.min_level}` : ''}</p>
        </div>
      </section>

      {saved && <p class="note ok">Saved. {saved === 'card' ? 'Your card in Discord updates within a few seconds.' : ''}</p>}
      {failed && <p class="note warn">That didn't save - please try again.</p>}

      <section class="box gold" data-tabs="hash">
        <div class="tabs" role="tablist">
          <button type="button" role="tab" data-tab="overview">🌱 Getting set up</button>
          <button type="button" role="tab" data-tab="card">💬 DM card</button>
          <button type="button" role="tab" data-tab="profiles">👤 Profiles</button>
          <button type="button" role="tab" data-tab="events">🎉 Events</button>
          <button type="button" role="tab" data-tab="reminders">⏰ Reminders</button>
          <button type="button" role="tab" data-tab="shelf">📚 Bookshelf</button>
          <button type="button" role="tab" data-tab="settings">⚙️ Settings</button>
        </div>

        <div data-panel="overview" role="tabpanel">
          <h2 style="text-align:center">{doneCount === checklist.length ? 'All set up 🎉' : `${doneCount} of ${checklist.length} done`}</h2>
          <p class="sub">A short list to get you settled. Tap one to go straight there.</p>
          <div class="rows" style="max-width:640px;margin:0 auto">
            {checklist.map((c) => (
              <button type="button" class="row check" data-go={c.tab}>
                <span class="t"><b>{c.done ? '✅' : '⬜'} {c.label}</b><span>{c.how}</span></span>
                <span class="muted">{c.done ? 'Done' : 'Go →'}</span>
              </button>
            ))}
          </div>
        </div>

        <div data-panel="card" role="tabpanel">
          <h2 style="text-align:center">Your DM card</h2>
          <p class="sub">Tells people if you're open to DMs and friend requests, and what you like to talk about. It shows on the DM board in Discord.{me.card.link && <> <a href={me.card.link}>See it in Discord</a>.</>}</p>
          <form method="post" action="/api/me/card" class="form">
            <fieldset>
              <legend>💬 Direct messages</legend>
              <div class="seg">
                {Object.entries(STATUS_LABEL).map(([k, v]) => <label><input type="radio" name="dm" value={k} checked={me.card.dm === k} /><span>{v}</span></label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend>🤝 Friend requests</legend>
              <div class="seg">
                {Object.entries(STATUS_LABEL).map(([k, v]) => <label><input type="radio" name="fr" value={k} checked={me.card.fr === k} /><span>{v}</span></label>)}
              </div>
            </fieldset>
            <label class="field">Do's <small>What you'd like people to do when they message you.</small>
              <textarea name="dos" maxlength="1000" placeholder="Say hi first and tell me which channel you saw me in">{me.card.dos}</textarea>
            </label>
            <label class="field">Don'ts <small>What you'd rather people didn't do.</small>
              <textarea name="donts" maxlength="1000" placeholder="No unsolicited pictures">{me.card.donts}</textarea>
            </label>
            {me.card.topics.length > 0 && (
              <fieldset>
                <legend>Topics</legend>
                <p class="muted small">For each topic, are you fine with it, want to be asked first, or not interested?</p>
                <div class="topics">
                  {me.card.topics.map((t) => (
                    <div class="topic">
                      <span>{t.name}</span>
                      <div class="seg">
                        <label><input type="radio" name={`topic_${t.id}`} value="" checked={!me.card.picked[t.id]} /><span>-</span></label>
                        {TOPIC_STATES.map((s) => <label title={s.label}><input type="radio" name={`topic_${t.id}`} value={s.key} checked={me.card.picked[t.id] === s.key} /><span>{s.emoji}</span></label>)}
                      </div>
                    </div>
                  ))}
                </div>
              </fieldset>
            )}
            <fieldset>
              <legend>Your own topics</legend>
              <p class="muted small">Anything not in the list. Separate with commas.</p>
              {TOPIC_STATES.map((s) => (
                <label class="field">{s.emoji} {s.label}
                  <input type="text" name={`own_${s.key}`} value={(me.card.own[s.key] || []).join(', ')} maxlength="600" />
                </label>
              ))}
            </fieldset>
            <div class="actions"><button class="btn solid" type="submit">Save my card</button></div>
          </form>
        </div>

        <div data-panel="profiles" role="tabpanel">
          <h2 style="text-align:center">Your profiles</h2>
          <p class="sub">Make or change one in Discord with <code>/profile make type:</code> and pick a type. Change the picture with <code>/profile picture</code>.</p>
          {me.profiles.length === 0 && <p class="note">No profiles yet. Start with <code>/profile make type:Introduction</code> in any channel.</p>}
          <div class="grid">
            {me.profiles.map((p) => (
              <div class="card" style="--a:var(--rose)">
                <span class="k">👤 Profile</span>
                <b>{p.label}</b>
                {p.fields.slice(0, 4).map((f) => <p><strong>{f.label}:</strong> {f.value.length > 140 ? `${f.value.slice(0, 140)}…` : f.value}</p>)}
                {p.link && <a class="btn small" href={p.link} style="justify-self:start;margin-top:6px">Open in Discord</a>}
              </div>
            ))}
          </div>
        </div>

        <div data-panel="events" role="tabpanel">
          <h2 style="text-align:center">Upcoming events</h2>
          <p class="sub">Press Going, Maybe or Not going on the event post in Discord. If you don't pick, you're counted as not going.</p>
          {me.events.length === 0 && <p class="note">Nothing planned right now - check back soon.</p>}
          <div class="rows">
            {me.events.map((e) => (
              <div class="row">
                <div class="t"><b>{e.title}</b><span>{fmt(e.starts_at, me.tz || e.tz)} · {e.going} going · You: {RSVP[e.mine] || 'not picked yet'}</span></div>
                {e.link && <a class="btn small" href={e.link}>Open in Discord</a>}
              </div>
            ))}
          </div>
        </div>

        <div data-panel="reminders" role="tabpanel">
          <h2 style="text-align:center">Your reminders</h2>
          <p class="sub">Set one in Discord with <code>/remind</code>. You can cancel them here.</p>
          {me.reminders.length === 0 && <p class="note">No reminders waiting.</p>}
          <div class="rows">
            {me.reminders.map((r) => (
              <form class="row" method="post" action="/api/me/reminder-delete">
                <div class="t"><b>{r.text}</b><span>{fmt(r.remind_at, me.tz)}</span></div>
                <input type="hidden" name="id" value={r.id} />
                <button class="btn small" type="submit">Cancel</button>
              </form>
            ))}
          </div>
        </div>

        <div data-panel="shelf" role="tabpanel">
          <h2 style="text-align:center">Your bookshelf</h2>
          <p class="sub">Add books in Discord with <code>/book add</code>. Your shelf shows on your profiles too.</p>
          {me.shelf.length === 0 && <p class="note">Your shelf is empty. Try <code>/book search</code> to find something.</p>}
          <div class="shelf">
            {me.shelf.map((b) => (
              <div class="book">
                {b.cover ? <img src={b.cover} alt="" loading="lazy" /> : <div class="nocover">📕</div>}
                <b>{b.title}</b>
                <span>{b.creator}</span>
                <span class="k">{SHELF[b.status] || b.status}{b.rating ? ` · ${'★'.repeat(b.rating)}` : ''}</span>
              </div>
            ))}
          </div>
        </div>

        <div data-panel="settings" role="tabpanel">
          <h2 style="text-align:center">Settings</h2>
          <form method="post" action="/api/me/timezone" class="form" style="max-width:520px;margin:0 auto">
            <label class="field">Your time zone <small>Shown on your profiles so people know when you're around. Event times on this page use it too.</small>
              <select name="tz">
                <option value="">Don't show a time zone</option>
                {zones.map((z) => <option value={z} selected={me.tz === z}>{z.replace(/_/g, ' ')}</option>)}
              </select>
            </label>
            <div class="actions"><button class="btn solid" type="submit">Save</button></div>
          </form>
        </div>
      </section>
    </>
  )}
</Layout>

<script>
  // Checklist rows jump to their tab.
  document.querySelectorAll<HTMLElement>('[data-go]').forEach((b) =>
    b.addEventListener('click', () => document.querySelector<HTMLButtonElement>(`.tabs [data-tab="${b.dataset.go}"]`)?.click())
  );
</script>

<style>
  .mehero img { width: 96px; height: 96px; border-radius: 50%; border: 2px solid var(--gold); }
  .lvl { max-width: 460px; margin: 16px auto 0; display: grid; gap: 6px; }
  .check { width: 100%; text-align: left; color: var(--text); font: inherit; cursor: pointer; }
  .check:hover { border-color: var(--gold); }
  .form { display: grid; gap: 18px; max-width: 720px; margin: 0 auto; }
  fieldset { border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px 16px; margin: 0; display: grid; gap: 10px; }
  legend { font: 400 18px var(--display); color: #fff; padding: 0 6px; }
  .topics { display: grid; gap: 8px; }
  .topic { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; border-top: 1px solid #ffffff14; padding-top: 8px; }
  .shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px; }
  .book { display: grid; gap: 4px; align-content: start; font-size: 13px; }
  .book img, .nocover { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 10px; border: 1px solid var(--gold); background: var(--panel-3); }
  .nocover { display: grid; place-items: center; font-size: 34px; }
  .book b { color: #fff; font-size: 14px; line-height: 1.25; }
  .book .k { font: 700 10px var(--mono); letter-spacing: 1px; color: var(--gold-soft); text-transform: uppercase; }
</style>

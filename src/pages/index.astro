---
import Layout from '../layouts/Layout.astro';
import data from '../data/generated/bots.json';
import { AREAS, BOT_COLORS, BOT_EMOJI } from '../data/site.js';
import { INVITE_URL } from '../lib/env.js';
import { hasDatabase } from '../lib/db.js';
import { getEvents } from '../lib/member-data.js';
import { what } from '../lib/md.js';

const firstSteps = data.topics.find((t) => t.key === 'new')?.items || [];
const commandCount = data.bots.reduce((n, b) => n + b.totalCommands, 0);
const events = hasDatabase() ? await getEvents().catch(() => []) : [];
const loginNote = Astro.url.searchParams.get('login');
const when = (d: Date, tz: string | null) =>
  new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: tz || 'UTC', timeZoneName: 'short' }).format(new Date(d));
---
<Layout title="Welcome">
  {loginNote === 'cancelled' && <p class="note">Login was cancelled - no problem. You can look around without logging in.</p>}
  {loginNote === 'failed' && <p class="note warn">Discord didn't let the login finish. Please try again in a minute.</p>}

  <section class="hero">
    <div class="eyebrow">Discord community · 18+</div>
    <h1 class="title">Black Rose <em>In Silver</em></h1>
    <p class="tagline">A friendly adult community for books, gaming, streaming and roleplay - with bots that do the busywork, so you can just talk to people.</p>
    <div class="counts">
      <div><strong>{AREAS.length}</strong><span>Areas</span></div>
      <div><strong>{data.bots.length}</strong><span>Bots</span></div>
      <div><strong>{commandCount}</strong><span>Commands</span></div>
    </div>
    <div class="actions">
      {INVITE_URL && <a class="btn solid" href={INVITE_URL}>Join the server</a>}
      <a class="btn gold" href="/start">New here? Start here</a>
      <a class="btn" href="/me">My space</a>
    </div>
  </section>

  <section class="box">
    <p class="t2">Your first ten minutes</p>
    <p class="sub">You don't need to learn anything first. Do these in order and you're settled in.</p>
    <div class="steps">
      {firstSteps.map((s) => (
        <div class="step">
          <b set:html={what(s.what)} />
          <p>{s.how.replace(/\*\*/g, '')}</p>
        </div>
      ))}
    </div>
    <div class="actions"><a class="btn gold" href="/start">See everything by topic</a></div>
  </section>

  <section class="box">
    <p class="t2">Find your corner</p>
    <p class="sub">Pick the areas you want on the areas panel in Discord. Some open up as you level up by chatting.</p>
    <div class="grid">
      {AREAS.map((a) => (
        <div class="card" style={`--a:${a.color}`}>
          <span class="k">{a.emoji} Area</span>
          <b>{a.name}</b>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  {events.length > 0 && (
    <section class="box">
      <p class="t2">Coming up</p>
      <p class="sub">Events run in the server. Press Going on the event post to get a reminder.</p>
      <div class="rows">
        {events.slice(0, 5).map((e) => (
          <div class="row">
            <div class="t"><b>{e.title}</b><span>{when(e.starts_at, e.tz)}{e.location ? ` · ${e.location}` : ''} · {e.going} going</span></div>
            {e.link && <a class="btn small" href={e.link}>Open in Discord</a>}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="box">
    <p class="t2">Meet the bots</p>
    <p class="sub">Each bot looks after one part of the server. You'll mostly use the first few.</p>
    <div class="grid">
      {data.bots.map((b) => (
        <a class="card" href={`/bots#${b.key}`} style={`--a:${BOT_COLORS[b.key]}`}>
          <span class="k">{BOT_EMOJI[b.key]} {b.commands.length} for members</span>
          <b>{b.name}</b>
          <p>{b.blurb}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

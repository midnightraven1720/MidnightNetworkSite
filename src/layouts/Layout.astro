---
import { getUser, avatarUrl } from '../lib/session.js';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Black Rose In Silver - an 18+ Discord community for books, games, streaming, roleplay and more.' } = Astro.props;
const path = Astro.url.pathname;
const user = getUser(Astro);
const links = [
  { href: '/', label: 'Home' },
  { href: '/start', label: 'Start here' },
  { href: '/bots', label: 'Our bots' },
  { href: '/me', label: 'My space' },
  ...(user?.staff ? [{ href: '/staff', label: 'Staff' }] : []),
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&display=swap" rel="stylesheet" />
    <title>{title} · Black Rose In Silver</title>
  </head>
  <body>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a href="/" class="brand"><span class="rose" aria-hidden="true">🥀</span><span>Black Rose <em>In Silver</em></span></a>
      <input type="checkbox" id="menu" class="menu-toggle" />
      <label for="menu" class="menu-btn" aria-label="Menu"><span></span><span></span><span></span></label>
      <nav class="nav">
        {links.map((l) => <a href={l.href} class={active(l.href) ? 'on' : ''}>{l.label}</a>)}
        {user ? (
          <span class="who">
            <img src={avatarUrl(user, 64)} alt="" width="28" height="28" />
            <span>{user.name}</span>
            <a href="/logout" class="out">Log out</a>
          </span>
        ) : (
          <a href={`/login?next=${encodeURIComponent(path)}`} class="btn gold small">Log in with Discord</a>
        )}
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <p>Black Rose In Silver · 18+ only · Not affiliated with Discord</p>
      <p><a href="/start">Start here</a> · <a href="/terms-of-use">Terms</a> · <a href="/privacy-policy">Privacy</a></p>
    </footer>

    <script>
      // Tabs: any [data-tabs] block; buttons [data-tab=x] show [data-panel=x].
      // The open tab follows the address (#x) so links can open one.
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
        const buttons = [...box.querySelectorAll<HTMLButtonElement>(':scope > .tabs [data-tab]')];
        const panels = [...box.querySelectorAll<HTMLElement>(':scope > [data-panel]')];
        const show = (key: string, push = false) => {
          if (!buttons.some((b) => b.dataset.tab === key)) return false;
          buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === key)));
          panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
          if (push && box.dataset.tabs === 'hash') history.replaceState(null, '', `#${key}`);
          return true;
        };
        buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!, true)));
        const fromHash = box.dataset.tabs === 'hash' && show(location.hash.slice(1));
        if (!fromHash) show(buttons[0]?.dataset.tab || '');
      });

      // Stars, as on the old site; still when reduced motion is on.
      (() => {
        const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
        const ctx = canvas?.getContext('2d');
        if (!canvas || !ctx) return;
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let stars: { x: number; y: number; r: number; b: number; p: number; s: number }[] = [];
        const resize = () => {
          canvas.width = innerWidth;
          canvas.height = innerHeight;
          stars = Array.from({ length: Math.floor((innerWidth * innerHeight) / 6500) }, () => ({
            x: Math.random() * innerWidth, y: Math.random() * innerHeight, r: Math.random() * 1.1 + 0.3,
            b: Math.random() * 0.5 + 0.3, p: Math.random() * 6.3, s: Math.random() * 0.0015 + 0.0005,
          }));
        };
        const draw = (t: number) => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          for (const s of stars) {
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, 6.3);
            ctx.fillStyle = `rgba(233,228,255,${Math.max(0.08, still ? s.b : s.b + Math.sin(t * s.s + s.p) * 0.3)})`;
            ctx.fill();
          }
          if (!still) requestAnimationFrame(draw);
        };
        addEventListener('resize', resize);
        resize();
        requestAnimationFrame(draw);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070a22;
    --panel: #0d1233;
    --panel-2: #10153f;
    --panel-3: #141a4a;
    --line: #2c2f6b;
    --gold: #d4af37;
    --gold-soft: #e8c766;
    --text: #e9e4ff;
    --lilac: #c9b8ff;
    --muted: #9a8fd1;
    --rose: #e0607e;
    --amber: #e0a030;
    --blue: #4a90e2;
    --green: #3fbf8f;
    --purple: #9d6bff;
    --display: Marcellus, Georgia, serif;
    --body: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: ui-monospace, Menlo, Consolas, monospace;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { margin: 0; }
  body {
    background: radial-gradient(90% 60% at 70% -10%, #2a1a5c 0, transparent 60%), var(--bg);
    color: var(--text);
    font: 16px/1.65 var(--body);
    min-height: 100vh;
  }
  #starfield { position: fixed; inset: 0; z-index: -1; pointer-events: none; }
  a { color: var(--gold-soft); }
  img { max-width: 100%; }
  p { margin: 0 0 10px; }
  h1, h2, h3, h4 { font-family: var(--display); font-weight: 400; color: #fff; margin: 0 0 8px; line-height: 1.15; }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 12px; top: 12px; background: var(--panel); padding: 8px 12px; z-index: 10; }

  /* ---------- top bar ---------- */
  .topbar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 16px; padding: 10px 20px; background: #070a22e6; backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .brand { display: flex; gap: 8px; align-items: center; font: 400 20px var(--display); color: #fff; text-decoration: none; white-space: nowrap; }
  .brand em { font-style: normal; color: var(--gold-soft); }
  .nav { display: flex; align-items: center; gap: 4px; margin-left: auto; flex-wrap: wrap; }
  .nav > a { padding: 7px 14px; border-radius: 999px; color: var(--text); text-decoration: none; font-weight: 600; font-size: 14px; }
  .nav > a:hover { background: var(--panel-2); }
  .nav > a.on { color: var(--gold-soft); box-shadow: inset 0 0 0 1px var(--gold); background: var(--panel-3); }
  .who { display: flex; align-items: center; gap: 8px; margin-left: 8px; font-size: 14px; }
  .who img { border-radius: 50%; border: 1px solid var(--gold); }
  .who .out { color: var(--muted); font-size: 13px; }
  .menu-toggle, .menu-btn { display: none; }
  @media (max-width: 820px) {
    .menu-btn { display: grid; gap: 4px; margin-left: auto; padding: 8px; cursor: pointer; }
    .menu-btn span { width: 22px; height: 2px; background: var(--gold-soft); }
    .nav { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; padding: 10px 16px 16px; background: var(--bg); border-bottom: 1px solid var(--line); }
    .menu-toggle:checked ~ .nav { display: flex; }
    .who { margin: 8px 0 0; }
  }

  /* ---------- layout ---------- */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 24px 16px 40px; display: grid; gap: 24px; }
  .foot { text-align: center; color: var(--muted); font: 12px var(--mono); letter-spacing: 1px; padding: 20px 16px 30px; }
  .foot a { color: var(--muted); }

  /* ---------- pieces (matching the Janitor profile style) ---------- */
  .hero { position: relative; overflow: hidden; text-align: center; border: 1px solid var(--gold); border-radius: 22px; padding: 64px 18px 24px; background: radial-gradient(70% 120% at 70% 0, #4a2a9c, #14103f 55%, #080b26); }
  .hero.small { padding: 36px 18px 22px; }
  .eyebrow { font: 700 11px var(--mono); letter-spacing: 4px; color: var(--gold-soft); text-transform: uppercase; }
  .title { font: 400 clamp(34px, 8vw, 70px)/0.98 var(--display); margin: 10px 0; letter-spacing: 1.5px; color: #fff; text-shadow: 0 0 40px #9d6bff66; }
  .title em { font-style: normal; color: var(--gold-soft); }
  .tagline { color: var(--lilac); max-width: 56ch; margin: 0 auto; }
  .counts { display: flex; justify-content: center; flex-wrap: wrap; margin-top: 18px; border-top: 1px solid #d4af3755; padding-top: 14px; }
  .counts div { padding: 0 clamp(14px, 4vw, 34px); border-left: 1px solid #d4af3744; }
  .counts div:first-child { border-left: 0; }
  .counts strong { display: block; font: 400 30px/1 var(--display); color: var(--gold-soft); }
  .counts span { font: 700 10px var(--mono); letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }
  .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }

  .box { border: 1px solid var(--line); border-radius: 18px; background: var(--panel); padding: 24px; min-width: 0; }
  .box.gold { border-color: var(--gold); }
  .t2 { font: 700 13px Georgia, serif; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin: 0 0 8px; text-align: center; }
  .sub { color: var(--muted); max-width: 62ch; margin: 0 auto 18px; text-align: center; }
  .muted { color: var(--muted); }
  .small { font-size: 14px; }

  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); font: 600 15px var(--body); text-decoration: none; cursor: pointer; }
  .btn:hover { border-color: var(--gold); }
  .btn.gold { border-color: var(--gold); color: var(--gold-soft); background: var(--panel-3); }
  .btn.solid { background: var(--gold); color: #0a0e2e; border-color: var(--gold); }
  .btn.small { padding: 6px 14px; font-size: 13px; }

  .tabs { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .tabs button { padding: 9px 18px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--text); font: 600 15px var(--body); cursor: pointer; }
  .tabs button[aria-selected='true'] { border-color: var(--gold); color: var(--gold-soft); background: var(--panel-3); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .card { --a: var(--gold); display: grid; gap: 6px; align-content: start; padding: 16px 18px; border: 1px solid var(--line); border-left: 5px solid var(--a); border-radius: 14px; background: var(--panel-2); text-decoration: none; color: var(--text); }
  a.card:hover { border-color: var(--a); }
  .card b { font: 400 20px var(--display); color: #fff; }
  .card .k { font: 700 10px var(--mono); letter-spacing: 1.5px; text-transform: uppercase; color: var(--a); }
  .card p { margin: 0; color: var(--lilac); font-size: 14px; }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; counter-reset: step; }
  .step { position: relative; padding: 18px 18px 16px 62px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel-2); }
  .step::before { counter-increment: step; content: counter(step); position: absolute; left: 16px; top: 16px; width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--gold); border-radius: 50%; font: 400 18px var(--display); color: var(--gold-soft); }
  .step b { display: block; font: 400 19px var(--display); color: #fff; margin-bottom: 2px; }
  .step p { margin: 0; font-size: 14px; color: var(--lilac); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { border: 1px solid var(--line); border-radius: 999px; padding: 2px 11px; font-size: 13px; background: var(--panel-2); }
  .chip.on { border-color: var(--gold); color: var(--gold-soft); }

  code, .cmd { font: 600 13px var(--mono); color: var(--gold-soft); background: #070a22; border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; overflow-wrap: anywhere; }

  .rows { display: grid; gap: 8px; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel-2); }
  .row .t { min-width: 0; }
  .row .t b { display: block; color: #fff; }
  .row .t span { font-size: 13px; color: var(--muted); }

  .note { border: 1px solid var(--line); border-left: 4px solid var(--gold); border-radius: 10px; padding: 10px 14px; background: var(--panel-2); font-size: 14px; }
  .note.ok { border-left-color: var(--green); }
  .note.warn { border-left-color: var(--rose); }

  details.faq { border: 1px solid var(--line); border-radius: 12px; background: var(--panel-2); margin-top: 8px; }
  details.faq summary { cursor: pointer; padding: 12px 16px; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  details.faq summary::-webkit-details-marker { display: none; }
  details.faq summary::after { content: '+'; color: var(--gold); font: 700 18px var(--mono); }
  details.faq[open] summary::after { content: '-'; }
  details.faq > div { padding: 0 16px 14px; color: var(--lilac); }

  label.field { display: grid; gap: 6px; font-weight: 600; font-size: 14px; }
  label.field small { font-weight: 400; color: var(--muted); }
  input[type='text'], textarea, select { width: 100%; font: 15px var(--body); color: var(--text); background: #070a22; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  textarea { min-height: 90px; resize: vertical; }
  input:focus, textarea:focus, select:focus { border-color: var(--gold); outline: none; }
  .seg { display: inline-flex; justify-self: start; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; flex-wrap: wrap; }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: block; padding: 7px 14px; font-size: 14px; font-weight: 600; }
  .seg input:checked + span { background: var(--gold); color: #0a0e2e; }
  .seg input:focus-visible + span { outline: 2px solid var(--gold-soft); outline-offset: -2px; }

  .bar { height: 10px; border-radius: 999px; background: #070a22; border: 1px solid var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--purple), var(--gold)); }

  @media (max-width: 600px) {
    .box { padding: 18px 14px; }
    .hero { padding: 48px 14px 20px; }
    .row { grid-template-columns: minmax(0, 1fr); }
  }
</style>

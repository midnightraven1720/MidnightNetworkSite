---
const { server } = Astro.props;
---
<div class="doc-container">
  {server.about.length > 0 ? (
    <>
      {server.about.map((p) => <p class="server-desc">{p}</p>)}

      {server.whatWeOffer.length > 0 && (
        <>
          <h4>✦ What We Offer ✦</h4>
          <ul class="offer-list">
            {server.whatWeOffer.map((item) => (
              <li>{item.emoji} <strong>{item.title}</strong> — {item.text}</li>
            ))}
          </ul>
        </>
      )}

      {server.standards.length > 0 && (
        <>
          <h4>✦ Our Standards ✦</h4>
          <ul class="offer-list">
            {server.standards.map((s) => <li>✅ {s}</li>)}
          </ul>
        </>
      )}

      {server.closingLines.map((line) => (
        <p class="server-desc closing-line">{line}</p>
      ))}
    </>
  ) : (
    <p class="placeholder-note">Description coming soon.</p>
  )}

  <div class="invite-wrap">
    <a href="#" class="invite-button">Join Server</a>
  </div>
</div>

<style>
  .doc-container { max-width: 650px; margin: 0 auto; text-align: left; font-family: var(--font-body); }
  .server-desc { color: var(--text-muted); line-height: 1.7; margin-bottom: 1rem; }
  .server-desc.closing-line { text-align: center; font-style: italic; }
  .server-desc.closing-line:last-child { font-weight: 700; font-style: normal; color: var(--text-primary); }
  h4 { font-family: var(--font-display); color: var(--star-silver); font-size: 1.1rem; text-align: center; margin-top: 2rem; margin-bottom: 1rem; }
  .offer-list { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .offer-list li { color: var(--text-muted); line-height: 1.6; margin-bottom: 0.75rem; }
  .offer-list strong { color: var(--text-primary); }
  .invite-wrap { text-align: center; margin-top: 1.5rem; }
  .invite-button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 2rem;
    background: var(--accent-violet);
    color: var(--night-deepest);
    text-decoration: none;
    border-radius: 100px;
    font-family: var(--font-utility);
    font-weight: 600;
    transition: background-color 0.2s ease;
  }
  .invite-button:hover { background: var(--moon-glow); }
  .placeholder-note { margin: 0 0 1.5rem; font-family: var(--font-utility); font-size: 0.9rem; color: var(--text-faint); line-height: 1.5; text-align: center; }
</style>

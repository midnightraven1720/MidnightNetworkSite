---
const { alerts } = Astro.props;
---
{alerts.length > 0 ? (
  <div class="doc-container">
    {alerts.map((alert) => (
      <div class="alert-card">
        <h4>{alert.title}</h4>
        <p class="event-date">{alert.date}</p>
        <p>{alert.message}</p>
      </div>
    ))}
  </div>
) : (
  <p class="placeholder-note">No alerts right now.</p>
)}

<style>
  .doc-container { max-width: 700px; margin: 0 auto; text-align: left; font-family: var(--font-body); }
  .alert-card {
    background: var(--night-card);
    border: 1px solid var(--card-border);
    border-radius: 4px;
    padding: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .alert-card h4 { font-family: var(--font-display); color: var(--star-silver); margin: 0 0 0.25rem; }
  .event-date { color: var(--accent-violet); font-family: var(--font-utility); font-size: 0.8rem; font-weight: 600; margin: 0 0 0.5rem; }
  .placeholder-note { margin: 0; font-family: var(--font-utility); font-size: 0.9rem; color: var(--text-faint); line-height: 1.5; text-align: center; }
</style>

---
const { guildOptionsData } = Astro.props;
---
<div class="panel">
  <h3>Server Roles &amp; Categories</h3>
  <div class="role-cols">
    <div>
      <h4>Roles</h4>
      <ul class="mini-list">
        {(guildOptionsData.roles || []).map((r) => <li>{r.name}</li>)}
      </ul>
    </div>
    <div>
      <h4>Categories</h4>
      <ul class="mini-list">
        {(guildOptionsData.categories || []).map((c) => <li>{c.name}</li>)}
      </ul>
    </div>
  </div>
</div>

<style>
  .panel { background: var(--night-card); border: 1px solid var(--card-border); border-radius: 4px; padding: 1.5rem; }
  .panel h3 { margin: 0 0 1rem; font-family: var(--font-display); font-size: 1.1rem; color: var(--star-silver); }
  .role-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .role-cols h4 { font-family: var(--font-utility); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-faint); margin: 0 0 0.5rem; }
  .mini-list { margin: 0; padding-left: 1.1rem; color: var(--text-muted); font-family: var(--font-body); font-size: 0.85rem; line-height: 1.6; }
</style>

---
const { title } = Astro.props;
---
<div class="card">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .card { background: var(--night-card); padding: 1.25rem; border-radius: 4px; border: 1px solid var(--card-border); }
  .card h3 { font-family: var(--font-display); font-size: 1.1rem; color: var(--star-silver); margin: 0 0 0.5rem; }
  .card :global(p) { margin: 0; font-family: var(--font-body); color: var(--text-muted); }
  .card :global(.placeholder-note) {
    font-family: var(--font-utility);
    font-size: 0.85rem;
    color: var(--text-faint);
    line-height: 1.5;
  }
</style>

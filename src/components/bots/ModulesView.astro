---
import { botData } from '../../data/bots.js';
import BackButton from '../BackButton.astro';
---
<div id="view-modules" style="display: none;">
  <div id="module-selection-grid" class="card-grid">
    {botData.map((bot) => (
      <div class="bot-card" onclick={`openModuleSubPage('${bot.id}')`}>
        <h4>{bot.name}</h4>
      </div>
    ))}
  </div>

  {botData.map((bot) => (
    <div class="module-sub-page" data-bot={bot.id} style="display: none;">
      <BackButton onclick="backToModuleGrid()" />
      <div class="module-sub-header">
        <h3>{bot.name}</h3>
        <span class="status-text active planned">{bot.status.toUpperCase()}</span>
      </div>
      <p class="bot-tagline">{bot.tagline}</p>

      <div class="category-list">
        {bot.categories.map((cat) => (
          <div class="category-chip">
            <span class="category-chip-label">{cat.label}</span>
            <span class="category-chip-count">{cat.commands.length}</span>
          </div>
        ))}
      </div>

      <div class="module-setup">
        <h4>Setup</h4>
        <p class="placeholder-note">Not connected yet — {bot.name} hasn't been redeployed since the restart. Setup controls will appear here once it's live and exposing its dashboard API.</p>
      </div>

      <div class="sub-page-footer">
        <BackButton onclick="backToModuleGrid()" />
      </div>
    </div>
  ))}
</div>

<style>
  .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-top: 0.75rem; }
  .bot-card { background: var(--night-card); border: 1px solid var(--card-border); padding: 0.7rem; cursor: pointer; border-radius: 4px; transition: border-color 0.2s ease; text-align: center; }
  .bot-card h4 { font-size: 0.68rem; margin: 0; color: var(--text-primary); }
  .bot-card:hover { border-color: var(--accent-violet); }

  .module-sub-header { display: flex; justify-content: space-between; align-items: center; margin: 0.75rem 0 0.35rem; }
  .module-sub-header h3 { margin: 0; font-family: var(--font-display); color: var(--star-silver); }
  .status-text { font-size: 0.55rem; color: var(--text-faint); background: var(--night-card); padding: 2px 6px; border: 1px solid var(--card-border); border-radius: 3px; text-transform: uppercase; font-weight: bold; }
  .bot-tagline { margin: 0 0 1rem; font-size: 0.8rem; color: var(--text-muted); max-width: 60ch; }

  .category-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .category-chip {
    display: flex; align-items: center; gap: 6px;
    background: var(--night-deepest); border: 1px solid var(--card-border-soft);
    border-radius: 100px; padding: 4px 10px 4px 12px; font-size: 0.7rem;
  }
  .category-chip-label { color: var(--text-muted); }
  .category-chip-count {
    background: var(--night-card); color: var(--text-faint); border-radius: 100px;
    padding: 1px 6px; font-size: 0.62rem;
  }

  .module-setup { margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--card-border-soft); }
  .module-setup h4 { font-size: 0.85rem; font-family: var(--font-display); color: var(--star-silver); margin: 0 0 0.5rem; }
  .placeholder-note { margin: 0; font-size: 0.85rem; color: var(--text-faint); line-height: 1.5; }
  .sub-page-footer { margin-top: 1.25rem; padding-top: 0.85rem; border-top: 1px solid var(--card-border-soft); }
</style>

---
import { botData } from '../../data/bots.js';
---
<div id="view-dashboard">
  <p class="overview-note">Every bot below was taken offline to rebuild the bot-coding side from scratch — none are deployed yet. Statuses will update here as each one comes back online.</p>
  <div class="overview-grid">
    <div class="overview-section">
      <h4>BOT ROSTER</h4>
      {botData.map((bot) => (
        <div class="data-item">
          <span>{bot.name}</span>
          <span class="status-text active planned">{bot.status.toUpperCase()}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .overview-note { font-size: 0.78rem; color: var(--text-faint); max-width: 60ch; margin: 0 0 1rem; }
  .overview-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .overview-section h4 { font-family: var(--font-utility); font-size: 0.65rem; letter-spacing: 0.08em; color: var(--text-faint); margin: 0 0 0.5rem; }
  .data-item { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.75rem; background: var(--night-card); border: 1px solid var(--card-border); border-radius: 4px; margin-bottom: 0.3rem; font-size: 0.8rem; color: var(--text-primary); }
  .status-text { font-size: 0.55rem; color: var(--text-faint); background: var(--night-deepest); padding: 2px 6px; border: 1px solid var(--card-border); border-radius: 3px; text-transform: uppercase; font-weight: bold; }
  .status-text.active.process { color: #22D3EE; border-color: #22D3EE; }
  .status-text.active.planned { color: var(--accent-gold); border-color: rgba(203, 164, 101, 0.35); }
</style>
